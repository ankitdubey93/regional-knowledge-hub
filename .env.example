# Copy to .env (gitignored) and fill in. Server-only: never prefix any of these with VITE_,
# because Vite bundles every VITE_* variable into public JavaScript.
NODE_ENV=development
PORT=5191
WEB_ORIGIN=http://localhost:5190

# Local Docker Postgres (docker-compose.yml). These are local-development credentials only.
# The app role chub_app is not a superuser, so row-level security applies to it.
DATABASE_URL=postgres://chub_app:chub_app@localhost:5437/chub
DATABASE_ADMIN_URL=postgres://chub:chub@localhost:5437/chub

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5191

# AI providers. GEMINI_API_KEY turns on knowledge-base embeddings (P2a); chat uses them from P3. Leave a key empty to turn that provider off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001
# Which provider answers chat: anthropic or gemini. Gemini chat needs a price row in server/src/ai/pricing.ts first.
CHAT_PROVIDER=anthropic

# Phase P4: encrypts stored uploads and the redaction map. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Phase P5d: key rotation (engineering/operations.md). VERSION (1 to 255) is written into every new seal; during a rotation,
# PREVIOUS holds the old key (version VERSION - 1) until `npm run db:reseal -w server` has finished.
DATA_ENCRYPTION_KEY_VERSION=1
DATA_ENCRYPTION_KEY_PREVIOUS=

# Spend guard (P3)
DAILY_SPEND_CAP_USD=5
CHAT_DAILY_MESSAGES_PER_USER=50

# Phase P5
# Mail (P5b). In development, Mailpit (docker compose service "mail") catches every mail: web UI at http://localhost:5439
SMTP_URL=smtp://localhost:5438
MAIL_FROM=no-reply@compliance-hub.local
REQUIRE_EMAIL_VERIFICATION=on

# Hops of trusted reverse proxy in front of the API; 0 in development.
RATE_LIMITS=on
TRUST_PROXY_HOPS=0

# Phase P5d: set only in the production image, where the API also serves the built web app from this folder.
WEB_DIST_DIR=
