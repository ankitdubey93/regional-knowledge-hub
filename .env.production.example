# The API container's settings (docker compose --profile prod). Copy to .env.production on the server; never commit it.
NODE_ENV=production
PORT=5191
# The public https origin. The API serves the web app itself, so both are the same.
WEB_ORIGIN=https://app.example.com
BETTER_AUTH_URL=https://app.example.com
# Host "db" is the Compose service. The API refuses to start with the development chub_app password.
DATABASE_URL=postgres://chub_app:CHANGE_ME@db:5432/chub
# openssl rand -base64 32 for each. Back up DATA_ENCRYPTION_KEY apart from the database first (engineering/operations.md).
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
DATA_ENCRYPTION_KEY_PREVIOUS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001
CHAT_PROVIDER=anthropic
DAILY_SPEND_CAP_USD=5
CHAT_DAILY_MESSAGES_PER_USER=50
# The production SMTP provider is not decided yet (engineering/operations.md).
SMTP_URL=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=on
RATE_LIMITS=on
# One reverse proxy on the same host terminates TLS: set to the real number of proxy hops.
TRUST_PROXY_HOPS=1
